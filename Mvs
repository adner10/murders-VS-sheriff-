local function lanzar(url)
    task.spawn(function()
        local exito, resultado = pcall(function()
            return game:HttpGet(url)
        end)
        if exito and resultado then
            local ejecutable = loadstring(resultado)
            if ejecutable then
                pcall(ejecutable)
            end
        end
    end)
end

